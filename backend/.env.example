# Copy this file to .env and fill in the values. Never commit .env.

# ── Frontend origin ────────────────────────────────────────────────────────────
ALLOWED_ORIGIN=http://localhost:3000

# ── watsonx / Granite ──────────────────────────────────────────────────────────
# IBM_WATSONX_* and WATSONX_* names are both accepted.
# The API key's IBMid must be a member (Editor) of the watsonx project.
IBM_WATSONX_API_KEY=
IBM_WATSONX_PROJECT_ID=
IBM_WATSONX_URL=https://eu-de.ml.cloud.ibm.com     # region of your watsonx project
IBM_WATSONX_MODEL=ibm/granite-4-h-small          # GRANITE_MODEL_ID also accepted

# ── GitHub ─────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=                                   # optional; fine-grained, no scopes

# ── Bob ────────────────────────────────────────────────────────────────────────
BOB_MODE=replay                                 # replay (default) | live (local dev only)

# ── Proxy ──────────────────────────────────────────────────────────────────────
# true only behind the nginx config in deploy/ (uses the last X-Forwarded-For entry)
TRUST_FORWARDED_FOR=false

# ── Sandbox ────────────────────────────────────────────────────────────────────
SANDBOX_IMAGE=medusa-optilearn:latest
MAX_CONCURRENT_SANDBOXES=6

# ── Ingest & scan limits ───────────────────────────────────────────────────────
# Public defaults are listed below (commented out). Uncomment and raise for LOCAL
# development only — never commit a .env with non-default values.
#
# Note: github.py derives its tarball download cap as MAX_ZIP_SIZE_BYTES * 10,
# so raising MAX_ZIP_SIZE_BYTES to 100 MB yields a ~1 GB download cap.
#
#MAX_ZIP_SIZE_BYTES=20971520          # 20 MB  (local suggestion: 104857600 = 100 MB)
#MAX_UNCOMPRESSED_BYTES=209715200     # 200 MB (local suggestion: 1073741824 = 1 GB)
#MAX_ZIP_FILES=2000                   # (local suggestion: 10000)
#MAX_GITHUB_REPO_SIZE_KB=51200        # 50 MB  (local suggestion: 102400 = 100 MB)
#SCAN_MAX_FILES=40                    # (local suggestion: 150)
#SCAN_MAX_LINES=6000                  # (local suggestion: 30000)
#SCAN_TIMEOUT_S=90                    # (local suggestion: 180)
