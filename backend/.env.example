# Copy this file to .env and fill in the values. Never commit .env.

# ── Frontend origin ────────────────────────────────────────────────────────────
ALLOWED_ORIGIN=http://localhost:3000

# ── watsonx / Granite ──────────────────────────────────────────────────────────
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
GRANITE_MODEL_ID=                               # confirm the id in Prompt Lab

# ── GitHub ─────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=                                   # optional; fine-grained, no scopes

# ── Bob ────────────────────────────────────────────────────────────────────────
BOB_MODE=replay                                 # replay (default) | live (local dev only)

# ── Sandbox ────────────────────────────────────────────────────────────────────
SANDBOX_IMAGE=medusa-optilearn:latest
MAX_CONCURRENT_SANDBOXES=6
